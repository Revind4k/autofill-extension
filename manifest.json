{
  "manifest_version": 3,
  "name": "Application Autofill \u2014 Eren",
  "version": "3.0.0",
  "description": "Fills job application forms. Reads each question with Claude before answering. Never submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_title": "Fill this form now"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "setter.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}